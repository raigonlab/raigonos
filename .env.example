# Copy this file to .env and fill in real local values.
# .env is git-ignored and must never be committed.

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True for local development, must be False in production
DEBUG=True

# Comma-separated, e.g. 127.0.0.1,localhost
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated, required in production for CSRF to work behind HTTPS,
# e.g. https://raigonos.onrender.com
CSRF_TRUSTED_ORIGINS=

# Provided automatically by Render's PostgreSQL add-on in production.
# Leave empty locally to fall back to SQLite.
DATABASE_URL=

# From your Cloudinary dashboard (Account Details / API Keys) — copy
# each of the three fields separately (Cloud Name, API Key, API Secret).
# Leave all three empty locally to save uploads to disk instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
